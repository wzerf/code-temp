# ============================================================
# deploy.env.example - 通用后端服务 env 配置模板
# 位置：backend/*/deploy/deploy.env.example
#
# 配合 deploy.sh 使用：
#   1. 复制为 /etc/<SERVICE_NAME>/<SERVICE_NAME>.env
#   2. 填入实际值
#   3. 运行 deploy.sh （会自动判断 service 文件是否存在，不存在则生成并启动）
#
# deploy.sh 会根据这些变量：
#   - 决定 service 文件名（/etc/systemd/system/${SERVICE_NAME}.service）
#   - 生成对应的 systemd 配置
#   - 直接启动服务
# ============================================================

# ---------- 服务安装相关（deploy.sh 必需） ----------
SERVICE_NAME=java-admin
JAR_NAME=java-admin-api.jar
APP_HOME=/opt/java-admin
ENV_FILE=/etc/java-admin/java-admin.env
SPRING_PROFILES_ACTIVE=prod

# ---------- 应用基础 ----------
APP_PORT=4080

# ---------- Nacos 配置中心 ----------
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USER=nacos
NACOS_PASSWORD=your-nacos-password
NACOS_NAMESPACE=java-admin-prod
NACOS_GROUP=DEFAULT_GROUP
NACOS_CONFIG_ENABLED=true

# ---------- MySQL 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=javaadmin
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ---------- Temporal（可选；空 target = 不启用 Spring 自动配置） ----------
# 本地 compose：gRPC 宿主机 4723、UI 4808（见 deploy/docker-compose.yml）
# Temporal Server 持久化复用 compose 内 MySQL（DB=mysql8，勿用默认 cassandra）
# 启用后：WorkflowClient 自动装配，TaskTriggerPort 切换为 TemporalTaskTriggerPort
# 若本进程也要消费任务：TEMPORAL_START_WORKERS=true（demo queue=demo，LogCountTickWorkflow）
# TEMPORAL_TARGET=127.0.0.1:4723
# TEMPORAL_NAMESPACE=default
# TEMPORAL_START_WORKERS=true
# TEMPORAL_PORT=4723
# TEMPORAL_UI_PORT=4808
# 内存上限（compose 默认；GOMEMLIMIT 须小于硬顶，建议约 85%）
# MYSQL_MEM_LIMIT=1024m
# REDIS_MEM_LIMIT=256m
# NACOS_MEM_LIMIT=1024m
# TEMPORAL_MEM_LIMIT=1024m
# TEMPORAL_GOMEMLIMIT=850MiB
# TEMPORAL_GOMAXPROCS=2
# TEMPORAL_UI_MEM_LIMIT=256m
# ADMINER_MEM_LIMIT=128m
# MINIO_MEM_LIMIT=512m
# MINIO_GOMEMLIMIT=425MiB

# ---------- MinIO / 对象存储（compose 默认起 MinIO） ----------
# 应用侧：app.storage.type=local|s3（见 application.yml）
# 本地 compose：API 宿主机 4900、Console 4901（见 deploy/docker-compose.yml）
# Console：http://127.0.0.1:4901  默认 minioadmin / minioadmin
# MINIO_API_PORT=4900
# MINIO_CONSOLE_PORT=4901
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# 不要设 MINIO_SERVER_URL 为宿主机映射口（如 http://127.0.0.1:4900），Console 登录会 network error
# MINIO_BROWSER_REDIRECT_URL=http://127.0.0.1:4901
# STORAGE_TYPE=s3
# STORAGE_S3_ENDPOINT=http://127.0.0.1:4900
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=java-admin
# STORAGE_S3_ACCESS_KEY=minioadmin
# STORAGE_S3_SECRET_KEY=minioadmin
# STORAGE_S3_PATH_STYLE=true

# ---------- JVM（可选） ----------
# deploy.sh 会自动补 -Duser.timezone=Asia/Shanghai；此处自行写了则不覆盖
# JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC
